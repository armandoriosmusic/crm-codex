# Entorno del servidor
NODE_ENV=development
PORT=3001

# Persistencia. La ruta relativa parte de la raíz del proyecto.
CRM_DATABASE_PATH=data/crm.sqlite

# Contraseñas iniciales de los usuarios. Sustituir solo en el .env local.
CRM_ARMANDO_PASSWORD=pon-aqui-una-contrasena-local
CRM_HUMBERTO_PASSWORD=pon-aqui-otra-contrasena-local

# Integración opcional con Gmail
GMAIL_CLIENT_ID=tu-client-id-de-google
GMAIL_CLIENT_SECRET=tu-client-secret-de-google
GMAIL_REDIRECT_URI=http://localhost:3001/gmail/oauth/callback
